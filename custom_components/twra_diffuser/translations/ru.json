              "blue": "Синий"
            }
          }
        }
      }
    },
    "button": {
      "preset_minimum": {
        "name": "Минимум"
      },
      "preset_eco": {
        "name": "Эко"
      },
      "preset_balanced": {
        "name": "Баланс"
      },
      "preset_rich": {
        "name": "Насыщенно"
      },
      "preset_guests": {
        "name": "Гости на 20 мин"
      }
    },
    "humidifier": {
      "intensity": {
        "name": "Интенсивность"
      }
