          "name": "Название"
        },
        "data_description": {
          "name": "Так устройство будет называться в Home Assistant, а потом и в приложении «Дом»."
        }
      },
      "password": {
        "description": "Диффузор защищён паролем приложения.",
        "data": {
          "password": "Пароль (4 символа)"
        }
      }
    },
    "error": {
      "cannot_connect": "Не удалось подключиться. Закройте приложение на телефоне и проверьте, что диффузор в зоне действия Bluetooth-адаптера или прокси.",
      "invalid_password": "Неверный пароль."
    },
    "abort": {
      "already_configured": "Этот диффузор уже добавлен.",
